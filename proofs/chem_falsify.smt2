; CHEM v1.0.0 — Pure QF_LIA 2-RDM SDP Lower-Bound AI Veto & Spin Parity Bounds
(set-logic QF_LIA)

(declare-const e_lb Int) (declare-const e_exact Int) (declare-const e_ub Int) (declare-const e_ai Int)

; CHECK 1: Anti-vacuity for certified active-space interval [e_lb, e_ub] (expect SAT)
(push)
(assert (<= e_lb e_exact))
(assert (<= e_exact e_ub))
(assert (< e_lb e_ub))
(check-sat)
(pop)

; CHECK 2: Rigorous AI/MLIP energy veto — valid e_ai >= e_exact cannot violate e_lb <= e_ai (expect UNSAT)
(push)
(assert (<= e_lb e_exact))
(assert (>= e_ai e_exact))
(assert (> e_lb e_ai))
(check-sat)
(pop)

; CHECK 3: Honest Theory Falsification — uncertified negative-slack dual falsifies valid e_ai (expect SAT)
(declare-const slack_err Int)
(push)
(assert (> slack_err 0))
(assert (= e_lb (+ e_exact slack_err)))
(assert (= e_ai e_exact))
(assert (> e_lb e_ai))
(check-sat)
(pop)

; CHECK 4: 2-RDM electron-spin parity invariant (nelec - 2S is even) (expect UNSAT)
(declare-const na Int) (declare-const nb Int) (declare-const nelec Int) (declare-const two_s Int) (declare-const k Int)
(push)
(assert (and (>= na 0) (>= nb 0)))
(assert (= nelec (+ na nb)))
(assert (= two_s (- na nb)))
(assert (= (- nelec two_s) (+ (* 2 k) 1)))
(check-sat)
(pop)
